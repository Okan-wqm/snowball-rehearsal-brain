  "source": "export function mean(values) {\n  if (values.length === 0) {\n    return 0;\n  }\n  var total = 0;\n  for (const value of values) {\n    total = total + value;\n  }\n  return total / values.length;\n}\n\nexport function summary(values) {\n  const count = values.length;\n  return { count: count, mean: mean(values) };\n}\n",
